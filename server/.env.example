# Cổng HTTP server lắng nghe (Render tự gán qua biến PORT).
PORT=4000

# Chuỗi kết nối PostgreSQL. Trên Render lấy từ dịch vụ Postgres (Internal URL).
# Ví dụ: postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL=

# Khoá bí mật ký JWT. BẮT BUỘC đổi khi triển khai thật.
JWT_SECRET=change-me-in-production

# Thời hạn token (ví dụ 7d, 12h).
JWT_EXPIRES_IN=7d

# Danh sách origin được phép (CORS), phân tách bằng dấu phẩy.
# Để trống để cho phép mọi origin (chỉ nên dùng khi phát triển).
ALLOWED_ORIGINS=

# Số xu khởi tạo cho tài khoản mới.
STARTING_COINS=5000

# Danh sách username được cấp quyền quản trị (bootstrap), phân tách bằng dấu phẩy.
# Ví dụ: ADMIN_USERNAMES=admin,walevmn
ADMIN_USERNAMES=
