// Schema Prisma cho Mini Game Hub (PostgreSQL).
// Thiết kế theo API_PLAN.md: User + Stats + MatchRecord + Room + RoomMember.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  displayName     String
  avatar          String?
  passwordHash    String
  coins           Int      @default(5000)
  isGuest         Boolean  @default(false)

  // Phân quyền: "user" (mặc định) hoặc "admin" (bảng quản trị, tặng xu, xoá tài khoản...).
  role            String   @default("user")

  // Tuỳ chọn người dùng (giữ phẳng cho đơn giản).
  sound           Boolean  @default(true)
  animations      Boolean  @default(true)
  preferLandscape Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stats            Stats?
  matches          MatchRecord[]
  hostedRooms      Room[]          @relation("RoomHost")
  memberships      RoomMember[]
  sentRequests     FriendRequest[] @relation("FriendRequestFrom")
  receivedRequests FriendRequest[] @relation("FriendRequestTo")
  friendshipsA     Friendship[]    @relation("FriendshipA")
  friendshipsB     Friendship[]    @relation("FriendshipB")
  sentMessages     DirectMessage[] @relation("DmSender")
  receivedMessages DirectMessage[] @relation("DmRecipient")
  purchases        Purchase[]
}

model Stats {
  userId  String @id
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches Int    @default(0)
  wins    Int    @default(0)
  losses  Int    @default(0)
  score   Int    @default(0)
}

model MatchRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String
  gameName     String
  placement    Int
  totalPlayers Int
  win          Boolean
  score        Int
  coinDelta    Int      @default(0)
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Room {
  id           String   @id @default(cuid())
  name         String
  gameId       String
  gameName     String
  visibility   String   @default("public") // public | private
  status       String   @default("waiting") // waiting | playing | closed
  maxPlayers   Int      @default(4)
  config       Json
  passwordHash String?
  hostId       String
  host         User     @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)

  members      RoomMember[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, visibility])
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isBot    Boolean  @default(false)
  botName  String?
  isHost   Boolean  @default(false)
  seat     Int      @default(0)
  coins    Int      @default(0)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

/// Lời mời kết bạn. Khi được chấp nhận, tạo thêm một bản ghi Friendship.
model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)
  /// pending | accepted | rejected
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromId, toId])
  @@index([toId, status])
}

/// Quan hệ bạn bè hai chiều (userAId và userBId luôn sắp xếp tăng dần để đảm bảo duy nhất).
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// Tin nhắn riêng tư giữa hai người chơi (chỉ gửi được cho bạn bè).
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// text (văn bản) | sticker (nhãn dán). Mặc định "text" để tương thích dữ liệu cũ.
  type        String    @default("text")
  text        String
  /// Id nhãn dán trong danh mục cửa hàng; null khi là tin nhắn văn bản.
  stickerId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// Vật phẩm người dùng đã mua trong cửa hàng (nhãn dán, khung chat, skin bài, khung avatar...).
/// Vật phẩm MIỄN PHÍ không lưu ở đây (xem `isFreeItem` trong src/data/shopCatalog.ts).
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}
