# Biến môi trường cho giao diện (Vite) — chạy Local.
#
# Để trống VITE_API_URL thì ứng dụng chạy ở chế độ Local/Demo (dữ liệu lưu trên thiết bị).
# Đặt VITE_API_URL trỏ tới backend để bật chế độ trực tuyến (tài khoản + phòng + ván realtime).

# Ví dụ: địa chỉ backend, KHÔNG kèm /api
VITE_API_URL=http://localhost:4000
